                                "api",
                                "v1",
                                "auth",
                                "refresh"
                            ]
                        }
                    }
                },
                {
                    "name": "4. Verify Email",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/auth/verify-email?token=sometoken",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "verify-email"
                            ],
                            "query": [
                                {
                                    "key": "token",
                                    "value": "sometoken"
                                }
                            ]
                        }
                    }
                },
